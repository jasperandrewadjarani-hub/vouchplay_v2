# VouchPlay web — environment template.
# Copy to .env.local and fill in when secrets are available (Phase 1). Never commit .env.local.

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (project itrosesiywpbaxtmucbb per handover) ---
# Get from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (login only — minimum scopes openid/email/profile, NO Gmail scopes) ---
# Configured in Supabase → Auth → Providers → Google; these are optional app-side flags.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Transactional email ---
# PILOT: Gmail SMTP via vouchplay@gmail.com (deliberate deviation from handover §34A.11 — see
# packages/core/src/notifications/email.ts). Auth-flow emails are sent by Supabase Auth using these
# same creds set as Supabase Custom SMTP (Dashboard → Project Settings → Auth → SMTP).
# App notification emails (Phase 11 outbox) also use these. Switch to a dedicated provider before scale.
EMAIL_TRANSPORT=gmail-smtp
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=vouchplay@gmail.com
# 16-char Gmail App Password (NOT the account password; requires 2FA enabled on the account).
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM=VouchPlay <vouchplay@gmail.com>

# --- Observability (optional in dev) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
