{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @vouchplay/web",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    { "path": "/api/cron/leaderboards", "schedule": "17 1 * * *" },
    { "path": "/api/cron/reminders", "schedule": "47 1 * * *" }
  ]
}
